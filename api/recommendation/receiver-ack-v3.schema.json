{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crabit:recommendation:receiver-ack-v3",
  "title": "receiver-ack-v3",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 3
    },
    "handoff_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "accepted": {
      "const": true
    }
  },
  "required": [
    "schema_version",
    "handoff_id",
    "accepted"
  ],
  "additionalProperties": false
}
