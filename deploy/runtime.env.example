# Copy to a mode-0600 file outside the repository and replace every placeholder.
CRABIT_ENV=staging
CRABIT_COMPOSE_PROJECT=crabit-staging
CRABIT_SPRING_PROFILE=e2e
CRABIT_PUBLIC_HOST=api-staging.203-0-113-10.sslip.io
CRABIT_DATABASE_NAME=crabit_staging
CRABIT_DATABASE_USERNAME=crabit
CRABIT_DATABASE_PASSWORD=replace-with-base64url-secret
CRABIT_BACKEND_IMAGE=crabitteam2/crabit-backend@sha256:replace-with-64-hex-digest

# Stable Demo only. Omit these keys for Staging.
CRABIT_DEMO_TOKEN_OWNER=replace-with-base64url-secret
CRABIT_DEMO_TOKEN_FRIEND=replace-with-base64url-secret
CRABIT_DEMO_TOKEN_NONFRIEND=replace-with-base64url-secret
CRABIT_DEMO_TOKEN_BLOCKED=replace-with-base64url-secret
CRABIT_DEMO_TOKEN_OTHER_ACADEMY=replace-with-base64url-secret
CRABIT_DEMO_TOKEN_STAFF=replace-with-base64url-secret
